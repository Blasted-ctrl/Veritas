  "components": [
    {
      "name": "Choose a file",
      "kind": "button",
      "description": "Production action button; theme properties inherit from the host.",
      "html": "<button class=\"ds-button-primary\">Choose a file</button>",
      "css": ".ds-button-primary{font-family:Hanken,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:24px;min-height:46px;padding:10px 22px;font-size:14px;font-weight:600;line-height:1.6;border:1px solid transparent;border-radius:8px;cursor:pointer;transition:background-color 120ms ease-out,color 120ms ease-out,transform 120ms ease-out;background:var(--accent,#416b4b);color:var(--accent-ink,#fafbf8);}.ds-button-primary:hover:not(:disabled){filter:brightness(.92);}.ds-button-primary:focus-visible{outline:3px solid var(--focus,#416b4b);outline-offset:4px;}.ds-button-primary:active:not(:disabled){transform:translateY(1px)}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-primary{animation:none!important;transition:none!important}}",
      "refersTo": "button-primary"
    },
    {
      "name": "Analyze again",
      "kind": "button",
      "description": "Production action button; theme properties inherit from the host.",
      "html": "<button class=\"ds-button-secondary\">Analyze again</button>",
      "css": ".ds-button-secondary{font-family:Hanken,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:24px;min-height:46px;padding:10px 22px;font-size:14px;font-weight:600;line-height:1.6;border:1px solid transparent;border-radius:8px;cursor:pointer;transition:background-color 120ms ease-out,color 120ms ease-out,transform 120ms ease-out;background:var(--surface-2,#e2e8df);color:var(--ink,#203b34);border-color:var(--line,#c9d2c8);}.ds-button-secondary:hover:not(:disabled){}.ds-button-secondary:focus-visible{outline:3px solid var(--focus,#416b4b);outline-offset:4px;}.ds-button-secondary:active:not(:disabled){transform:translateY(1px)}.ds-button-secondary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-secondary{animation:none!important;transition:none!important}}",
      "refersTo": "button-secondary"
    },
    {
      "name": "Text action",
      "kind": "button",
      "description": "Underlined recovery or file replacement action.",
      "html": "<button class=\"ds-text-action\">Choose another file</button>",
      "css": ".ds-text-action{font-family:Hanken,Arial,sans-serif;background:none;border:0;padding:0;color:var(--accent,#416b4b);font-size:13px;line-height:1.6;text-decoration:underline;text-underline-offset:4px;cursor:pointer;transition:transform 120ms ease-out}.ds-text-action:focus-visible{outline:3px solid var(--focus,#416b4b);outline-offset:4px;}.ds-text-action:active{transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-text-action{animation:none!important;transition:none!important}}",
      "refersTo": "button-text"
    },
    {
      "name": "Icon action",
      "kind": "button",
      "description": "Plain icon control with tonal hover ground.",
      "html": "<button class=\"ds-icon-action\" aria-label=\"Remove file\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m18 6-12 12M6 6l12 12\"/></svg></button>",
      "css": ".ds-icon-action{font-family:Hanken,Arial,sans-serif;display:grid;place-items:center;width:36px;height:36px;border:0;border-radius:8px;background:transparent;color:var(--ink,#203b34);cursor:pointer;transition:background-color 120ms ease-out,transform 120ms ease-out}.ds-icon-action:hover{background:var(--surface-2,#e2e8df)}.ds-icon-action:focus-visible{outline:3px solid var(--focus,#416b4b);outline-offset:4px;}.ds-icon-action:active{transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-icon-action{animation:none!important;transition:none!important}}",
      "refersTo": "button-icon"
